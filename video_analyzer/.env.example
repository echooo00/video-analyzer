# 阿里百炼 DashScope API Key (画面分析用 Qwen-VL)
VLM_API_KEY=sk-118483277b5443ecaae968db0976dc4f
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-max

# DeepSeek API Key (文本总结)
LLM_API_KEY=sk-209388ba54dd4ffc9522895b6ff1f77d
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 阿里百炼 ASR API Key (备选语音转写)
ASR_API_KEY=

# 语音转写后端: "local" (faster-whisper) 或 "dashscope"
TRANSCRIPTION_BACKEND=local
WHISPER_MODEL_SIZE=medium
WHISPER_LANGUAGE=zh

# FFmpeg 路径（默认已设置 Tecplot 自带路径）
# FFMPEG_PATH=D:\Tecplot\Tecplot 360 EX 2022 R1\bin\ffmpeg.exe
# FFPROBE_PATH=D:\Tecplot\Tecplot 360 EX 2022 R1\bin\ffprobe.exe

# 场景检测阈值（SSIM 低于此值视为场景切换，0-1，越小越敏感）
# SCENE_THRESHOLD_SSIM=0.5

# 最大分析关键帧数
# MAX_KEYFRAMES=60
